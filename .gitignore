# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Secrets — never commit
.env
.env.*
*.pem
*.key
secrets.json

# Dependencies / build output (this site has none, but keep the guard)
node_modules/
dist/
build/

# Logs and temp files
*.log
npm-debug.log*
.cache/
tmp/

# Client-acquisition hub: outreach templates, lead tracker and pipeline notes.
# Contains prospect names and contact details. This repository is PUBLIC and
# every committed file is deployed to the live site, so the folder is never
# committed. It lives only in the local (OneDrive-synced) working copy.
client-acquisition/
